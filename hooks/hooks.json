{
  "description": "done-check: block a 'done' claim once when no passing test ran after the last code edit",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/done-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
